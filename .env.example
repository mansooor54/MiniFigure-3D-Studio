# MiniFigure 3D Studio optional external-provider configuration.
# Copy only to the user-local application configuration location after an
# external provider is explicitly selected. Do not commit the resulting file.
# Prefer importing credentials into Windows Credential Manager or DPAPI-backed
# storage rather than retaining plaintext values.

MINIFIGURE_EXTERNAL_PROVIDER=
MINIFIGURE_EXTERNAL_API_BASE=
MINIFIGURE_EXTERNAL_API_KEY=

# No provider is enabled by default.
